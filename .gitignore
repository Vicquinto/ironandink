# Licensed NASB 1995 text — regenerable cache fetched from API.Bible, never committed
data/nasb-cache.json

# Local review artifact (generated diff) — not part of the codebase
nasb.diff

# Backups written by scripts/number-study-verses.js --apply
data/*.backup-verse-numbers-*.json

# Study bookmarks (routes/study-bookmarks.js)
data/study_bookmarks.json
sessions/
.claude/launch.json

# Original-language data (STEPBible) — 45 MB, built on the server by
# scripts/build-original-data.js; never committed
orig/
orig.building/
