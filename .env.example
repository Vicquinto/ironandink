# Iron & Ink — environment template. Copy to .env and fill in real values.
# .env itself is gitignored; only this template is committed.

PORT=4000
SESSION_SECRET=
ANTHROPIC_API_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ─── Scripture: NASB 1995 via API.Bible ──────────────────────────────────────
# NASB 1995 is the primary displayed translation. Verse text is fetched from
# API.Bible on demand and cached locally in data/nasb-cache.json (gitignored,
# refreshed within 30 days by a monthly cron). Only API_BIBLE_KEY is a secret;
# the Bible id and base URL below are public and already defaulted in lib/nasb.js.
# If API_BIBLE_KEY is unset the platform runs entirely on the ASV fallback.
API_BIBLE_KEY=
# Optional overrides (defaults live in lib/nasb.js):
# API_BIBLE_ID=b8ee27bcd1cae43a-01
# API_BIBLE_BASE=https://rest.api.bible

# ─── Billing (dark by default) ───────────────────────────────────────────────
# Leave BILLING_ENABLED=false and every Stripe value blank until going live.
# With the flag off the site behaves exactly as it did before billing existed.
# See docs/BILLING-GO-LIVE.md. Changing these touches server.js env, so a full
# `pm2 restart` (not `pm2 reload`) is required to pick them up.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
