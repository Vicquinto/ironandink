# Iron & Ink — environment template. Copy to .env and fill in real values.
# .env itself is gitignored; only this template is committed.

PORT=4000
SESSION_SECRET=
ANTHROPIC_API_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ─── Billing (dark by default) ───────────────────────────────────────────────
# Leave BILLING_ENABLED=false and every Stripe value blank until going live.
# With the flag off the site behaves exactly as it did before billing existed.
# See docs/BILLING-GO-LIVE.md. Changing these touches server.js env, so a full
# `pm2 restart` (not `pm2 reload`) is required to pick them up.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
